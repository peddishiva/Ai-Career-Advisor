PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWE1_KEY=your_windsurf_api_key

# Phase 4A authentication. The backend verifies access tokens only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

# Phase 4A database. Use PostgreSQL in deployed environments.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_career_advisor
DATABASE_ECHO=false

# Phase 4A private storage. Use local only for development without Supabase.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=uploads/private
STORAGE_MAX_OBJECT_BYTES=5242880
SUPABASE_STORAGE_BUCKET=career-private
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Optional Phase 3C AI enrichment. Credentials stay server-side.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-001
AI_API_KEY_ENV_VAR=GEMINI_API_KEY
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_RETRIES=0
AI_TEMPERATURE=0.2
