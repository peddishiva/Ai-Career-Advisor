PORT=5000
SWE1_KEY=your_windsurf_api_key
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Optional Phase 3C AI enrichment. Credentials stay server-side.
AI_ENABLED=false
AI_PROVIDER=gemini
