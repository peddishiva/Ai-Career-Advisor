# ===== AI Career Advisor - Environment Variables Template =====
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ===== Gemini AI API Key (Optional) =====
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Optional Phase 3C AI Enrichment =====
# Keep disabled unless a server-side provider credential is configured.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-001
AI_API_KEY_ENV_VAR=GEMINI_API_KEY
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_RETRIES=0
AI_TEMPERATURE=0.2

# ===== Firebase Configuration (Optional) =====
# Only needed if using Firebase authentication
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# ===== Backend Configuration =====
PORT=5000
UPLOAD_DIR=./uploads

# ===== Frontend Configuration =====
NEXT_PUBLIC_API_URL=http://localhost:5000
