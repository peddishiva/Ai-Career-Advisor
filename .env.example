# ===== AI Career Advisor - Environment Variables Template =====
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ===== Gemini AI API Key (Optional) =====
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Optional Phase 3C AI Enrichment =====
# Keep disabled unless a server-side provider credential is configured.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-001
AI_API_KEY_ENV_VAR=GEMINI_API_KEY
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_RETRIES=0
AI_TEMPERATURE=0.2

# ===== Phase 4A Supabase Auth / Database / Private Storage =====
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_career_advisor
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./uploads/private
SUPABASE_STORAGE_BUCKET=career-private
# Backend only. Never add this to frontend environment variables.
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# ===== Backend Configuration =====
PORT=5000
UPLOAD_DIR=./uploads

# ===== Frontend Configuration =====
NEXT_PUBLIC_API_URL=http://localhost:5000
